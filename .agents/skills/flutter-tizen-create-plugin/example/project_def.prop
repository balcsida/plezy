# See https://docs.tizen.org/application/tizen-studio/native-tools/project-conversion
# for the full field list.

APPNAME = foo_tizen_plugin
type = staticLib
profile = common-5.5

# Source files
USER_SRCS += src/*.cc

# User defines
USER_DEFS =
USER_UNDEFS =
USER_CPP_DEFS = FLUTTER_PLUGIN_IMPL
USER_CPP_UNDEFS =

# Includes
USER_INC_DIRS = inc src
USER_INC_FILES =
USER_CPP_INC_FILES =

# Tizen Native pkg-config modules — pulls both include dirs and link
# libs. `capi-*` goes here, NOT in USER_LIBS.
USER_PKGS = capi-appfw-app-common

# Plain link libraries (no -l prefix). Most staticLib plugins do not
# need this — leave empty unless you depend on libs without a
# pkg-config module.
USER_LIBS =
